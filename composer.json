{
    "name": "rsmmonaem/laravel-meta-ads-attribution",
    "description": "Production-ready Meta/Facebook Ads attribution, customer journey tracking, order attribution, and delivered-order Conversions API (CAPI) system for Laravel e-commerce.",
    "keywords": [
        "laravel",
        "meta",
        "facebook",
        "facebook-pixel",
        "conversions-api",
        "capi",
        "attribution",
        "fbclid",
        "utm-tracking",
        "ecommerce",
        "delivered-order-conversions"
    ],
    "homepage": "https://github.com/rsmmonaem/laravel-meta-ads-attribution",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "RsmMonaem",
            "email": "vrkm55@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "RsmMonaem\\MetaAdsAttribution\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RsmMonaem\\MetaAdsAttribution\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RsmMonaem\\MetaAdsAttribution\\MetaAdsAttributionServiceProvider"
            ],
            "aliases": {
                "MetaAttribution": "RsmMonaem\\MetaAdsAttribution\\Facades\\MetaAttribution"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
